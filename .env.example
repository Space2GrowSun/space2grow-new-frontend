# # --- Backend Configuration ---
# # Variables intended for future CMS and Database integration
# VITE_SANITY_PROJECT_ID=jajx8tjq
# VITE_SANITY_DATASET=production
# VITE_SANITY_API_VERSION=2026-07-01

# The deployed Sanity Studio URL (used for "Open Studio" links)
VITE_SANITY_STUDIO_URL=https://space2grow.sanity.studio

# Firebase Auth Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# # --- Creator Dashboard ---
# # Write token: sanity.io/manage → your project → API → Tokens → Add (Editor role)
# VITE_SANITY_WRITE_TOKEN=your_sanity_editor_token_here
# # Password to protect /dashboard (leave empty to disable)
# VITE_DASHBOARD_PASSWORD=
